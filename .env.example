# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Postgres with PostGIS. Unset disables position history (the realtime path
# still works, but analytics and replay return nothing).
DATABASE_URL=postgresql://citybus:citybus@127.0.0.1:5432/citybus

# Redis holds live vehicle state. Unset falls back to an in-process store, which
# is fine for one instance and wrong for more than one.
REDIS_URL=redis://127.0.0.1:6379

# Shared secret vehicles present when posting positions. Startup refuses to run
# with this default when NODE_ENV=production.
INGEST_TOKEN=dev-ingest-token

# Realtime broadcast rate to connected clients.
BROADCAST_HZ=2
# A vehicle silent for this long is dropped from the live map.
VEHICLE_STALE_SEC=90

# Built-in vehicle simulator. Turn this off once real vehicles post to /api/ingest.
SIMULATOR_ENABLED=true
SIMULATOR_TIME_SCALE=8
SIMULATOR_REPORT_HZ=2
SIMULATOR_GPS_NOISE_M=8
SIMULATOR_SEED=20260916
